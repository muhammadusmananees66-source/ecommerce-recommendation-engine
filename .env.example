# Copy to .env and fill in for your environment.
# All of these map to config keys via the RAG_ env-prefix convention in
# src/utils/config.py, EXCEPT the ones consumed directly by name below
# (REDIS_HOST/PORT, OPENAI_API_KEY etc.) which the code reads via os.environ
# in specific modules (feature_store.py, user_history.py, rate_limit.py,
# response_generator.py) -- check those files if a variable here doesn't
# seem to do anything, since not every var is wired through load_config.

ENVIRONMENT=development

# Redis (used by rate limiting, user history, feature store -- all have a
# working in-memory fallback if this is unset/unreachable)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
RAG_AUTH__SECRET_KEY=dev-secret-change-me

# Optional LLM providers -- only used if you install the llm-providers
# extra (pip install -e ".[llm-providers]") and add the model names to
# llm.available_models in config. Without these, the pipeline still works
# end-to-end via the built-in "local-echo" test provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional vector DB -- only used if vector_store.backend=pinecone and the
# vector-db extra is installed. Without it, the app uses the bounded
# in-memory vector store (fine for small/medium catalogs and for dev).
PINECONE_API_KEY=

# Optional MLflow -- only used if the mlops extra is installed and reachable;
# ExperimentTracker/ModelRegistry no-op safely (or raise loudly for registry
# writes) if this isn't set or isn't reachable.
MLFLOW_TRACKING_URI=http://localhost:5000

# Trained recommender model path (see scripts/train_model.py). Without this
# set, the recommendations endpoint returns an empty list, not an error.
RAG_MODEL__PATH=models/hybrid_v1

# RAG vector store seed (see scripts/generate_sample_data.py +
# Container._seed_vector_store). Without this, RAG queries retrieve nothing.
RAG_RAG__SEED_ITEMS_PATH=data/items.parquet
